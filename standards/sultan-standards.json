  "phases": {
    "names": [
      "Existing",
      "New Construction"
    ],
    "existing_graphics": "halftone",
    "rule": "Every element and view has a phase; existing is always halftone through the phase graphics. Each discipline file owns its own existing elements (existing ducts in MECH, existing sockets in ELEC); the EXT model holds the building shell (architecture and structure) only.",
    "status_parameter": {
      "name": "SF_PhaseStatus",
      "type": "text, instance, all model categories",
      "values": {
        "Existing-Retain": "Existing, stays (Phase Created Existing)",
        "Existing-Remove": "Existing, removed (Phase Created Existing, Phase Demolished New Construction)",
        "Existing-Relocate": "Existing, taken out to be re-installed elsewhere (demolished in New Construction; the new position is a separate New-Relocated element)",
        "New": "New work (Phase Created New Construction)",
        "New-Relocated": "Existing item re-installed in a new position (Phase Created New Construction; Comments name the original)",
        "Temporary": "Temporary phase, removed in New Construction"
      },
      "guid": "dffe7134-1feb-4f17-824d-e42054ac39e7"
    },
    "verification_parameter": {
      "name": "SF_ExistingSource",
      "values": [
        "Survey",
        "Site-Verified",
        "Record-Drawing",
        "Assumed"
      ],
      "rule": "Every existing element records how it is known. Phase says when; this says how sure.",
      "guid": "2cef8088-ecce-4776-9424-5951d922cd92"
    },
    "maturity_parameter": {
      "name": "SF_Maturity",
      "values": [
        "Reservation",
        "Gross",
        "Design",
        "Fabrication",
        "As-Built"
      ],
      "rule": "Reservation: space or position only, not a product. Gross: overall envelope, build-up not split. Design: sized design element. Fabrication: shop-ready. As-Built: verified installed.",
      "guid": "f3e1f3c6-3315-4e24-a510-bdd1717f9bcf"
    },
    "audit_tool": "node tools/phase_audit.mjs <model.rvt> [--ext] : reports elements with no phase, New elements in an EXT model, Existing elements without SF_PhaseStatus/SF_ExistingSource, status/phase mismatches, and views without a phase filter."
