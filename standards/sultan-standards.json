    "5_regional_and_support": [
      {
        "id": "BS 8536-1:2015",
        "scope": "design and construction for operation",
        "how": "reference"
      },
      {
        "id": "BS 8541-1..4",
        "scope": "object libraries",
        "how": "family naming and content, to adopt"
      },
      {
        "id": "BS ISO 55000",
        "scope": "asset management",
        "how": "tied to COBie; reference"
      },
      {
        "id": "NBIMS-US V4",
        "scope": "US national BIM standard",
        "how": "reference"
      },
      {
        "id": "Qatar / Dubai / Abu Dhabi BIM standards",
