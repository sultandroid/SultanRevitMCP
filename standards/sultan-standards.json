  "coordination": {
    "_note": "Coordination views only; sheets stay black and white. Order of precedence, applied as view filters (top filter wins): 1 Existing work (SF_PhaseStatus begins with 'Existing') grey halftone; 2 Reservations and gross envelopes (SF_Maturity = Reservation or Gross) surface 60% / 40% transparent with dashed edges; 3 sub-discipline colour by category (each discipline has a base Okabe-Ito family hue plus distinct sub_colours per category so floors, ceilings, walls, doors, joinery, furniture, ducts, terminals, panels, trays, lighting, power, AV, fire alarm and security never blend together). Host-view filters and category overrides also act on linked models shown By Host View, so one set colours a federated model; never colour or halftone the Revit Links category itself (that greys every link). Put colourKey() or subColourKey() on coordination sheets.",
    "palette": "Okabe-Ito family hues with sub-discipline shades (colour-blind safe)",
    "filters": {
      "existing": {
        "name": "SF COORD 1 Existing",
        "parameter": "SF_PhaseStatus",
        "rule": "begins_with",
        "value": "Existing",
        "halftone": true,
        "color": [
          160,
          160,
          160
        ]
      },
      "reservation": {
        "name": "SF COORD 2 Reservation",
        "parameter": "SF_Maturity",
        "rule": "begins_with",
        "value": "Res",
        "transparency": 60,
        "line_pattern": "Dash"
      },
      "gross": {
        "name": "SF COORD 3 Gross",
        "parameter": "SF_Maturity",
        "rule": "equals",
        "value": "Gross",
        "transparency": 40
