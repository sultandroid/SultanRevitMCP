  "bim_standards": {
    "_about": "BIM/Revit standards by tier, most important for our work first (user list, 4 Nov 2026). Editions as given; confirm the current edition before quoting one on a deliverable. how = what SultanRevitMCP does about it today.",
    "1_information_management": [
      {
        "id": "ISO 19650-1:2018",
        "scope": "concepts and principles: EIR, BEP, CDE, MIDP/TIDP",
        "how": "sheet and file naming follows the 19650 container name; BEP, EIR and CDE are not set up yet"
      },
      {
        "id": "ISO 19650-2:2018",
        "scope": "delivery phase",
        "how": "revisions in Revit, issue status; suitability codes (S/A) used only if the client sets them"
      },
      {
        "id": "ISO 19650-3:2020",
        "scope": "operational phase",
        "how": "not in scope for shopfit deliveries"
      },
      {
        "id": "ISO 19650-4:2022",
        "scope": "information exchange",
        "how": "exchange review before issue = the Before issuing checklist"
      },
      {
        "id": "ISO 19650-5:2020",
        "scope": "security-minded information management",
        "how": "repo and models private; no project data in the repo"
      },
      {
        "id": "ISO 19650-6:2025",
        "scope": "health and safety information",
        "how": "not applied yet"
      },
      {
        "id": "BS 1192:2007, PAS 1192-2/3/4",
        "scope": "superseded by ISO 19650",
        "how": "do not cite"
      }
    ],
    "2_level_of_information_need": [
      {
        "id": "ISO 7817-1:2024",
        "scope": "level of information need (replaces the LOD idea)",
        "how": "to adopt: state geometry, information and documentation needed per item in the BEP"
      },
      {
        "id": "EN 17412-1:2020",
        "scope": "its European predecessor",
        "how": "reference only"
      },
      {
        "id": "BIMForum LOD Specification 2023",
        "scope": "LOD 100-500 element definitions",
        "how": "shopfit joinery is modelled at fabrication level (about LOD 400)"
      },
      {
        "id": "AIA G202-2013 / E202-2008",
        "scope": "old US LOD definitions",
        "how": "reference only"
      }
    ],
    "3_open_data": [
      {
        "id": "ISO 16739-1:2024",
        "scope": "IFC 4.3 (4.3.2.0)",
        "how": "IFC export when asked; see drawing-and-bim-standards IFC section"
      },
      {
        "id": "ISO 12006-2 / 12006-3",
        "scope": "classification framework and object structure",
        "how": "not applied yet"
      },
      {
        "id": "ISO 29481-1 / -2",
        "scope": "IDM, information delivery manual",
        "how": "not applied yet"
      },
      {
        "id": "ISO 23386:2020",
        "scope": "property definitions",
        "how": "not applied yet"
      },
      {
        "id": "ISO 23387:2025",
        "scope": "data templates",
        "how": "not applied yet"
      },
      {
        "id": "COBie (BS 1192-4:2014)",
        "scope": "operations data hand-over",
        "how": "only if the client asks"
      },
      {
        "id": "buildingSMART IDS, bSDD, BCF",
        "scope": "information requirements check, data dictionary, issue exchange",
        "how": "BCF fits our clash reports; IDS could automate model checks"
      }
    ],
    "4_drawing_and_output": [
      {
        "id": "ISO 7200:2004",
        "scope": "title block data fields",
        "how": "title blocks A0-A3 carry its fields"
      },
      {
        "id": "ISO 5457:1999",
        "scope": "sheet sizes and layout",
        "how": "A0-A3 frames, grid, drawing area"
      },
      {
        "id": "ISO 128 series",
        "scope": "presentation, lines, views",
        "how": "lines.styles, black on white, hidden line"
      },
      {
        "id": "ISO 3098-1",
        "scope": "lettering",
        "how": "text.types, 2.5 mm minimum, 5 mm house"
